{
  "name": "nest-planner",
  "version": "1.0.3",
  "private": true,
  "description": "栖时 · 日程、专注与灵感的个人桌面",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "prepare:desktop": "node node_modules/electron/install.js",
    "desktop": "npm run prepare:desktop && npm run build && electron .",
    "package": "npm run prepare:desktop && npm run build && electron-builder --win portable --x64",
    "test:ui": "playwright test",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.nest.planner",
    "productName": "Nest Planner",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "artifactName": "Nest-Planner-${version}-Windows.${ext}"
  }
}
